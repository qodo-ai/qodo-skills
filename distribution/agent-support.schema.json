{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qodo-ai/qodo-skills/blob/main/distribution/agent-support.schema.json",
  "title": "Qodo coding-agent support contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidence", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "event", "property", "snapshotDate", "note"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "snapshotDate": { "type": "string", "format": "date" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "observedHostAgentIds",
          "delivery",
          "artifact",
          "supportTier",
          "nativeAcceptanceRequired"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "observedHostAgentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "delivery": { "enum": ["marketplace", "direct"] },
          "artifact": { "type": "string", "minLength": 1 },
          "supportTier": { "enum": ["package-ready", "validated", "listed"] },
          "nativeAcceptanceRequired": { "type": "boolean" }
        }
      }
    }
  }
}
