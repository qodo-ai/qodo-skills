{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qodo-ai/qodo-skills/blob/main/distribution/marketplaces.schema.json",
  "title": "Qodo official marketplace release contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "mode", "submissionUrl", "directoryUrl", "listings"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "mode": {
            "enum": ["provider-pinned-git", "reviewed-portal-snapshot", "live-git-directory"]
          },
          "submissionUrl": { "type": "string", "format": "uri" },
          "directoryUrl": { "type": "string", "format": "uri" },
          "directoryManifestUrl": { "type": "string", "format": "uri" },
          "listings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "id", "sourcePath"],
              "properties": {
                "package": { "type": "string", "pattern": "^qodo(?:-[a-z0-9-]+)?$" },
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "sourcePath": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" }
              }
            }
          }
        }
      }
    }
  }
}
