{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qodo-ai/qodo-skills/blob/main/distribution/catalog.schema.json",
  "title": "Qodo skills distribution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "runtime", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "version", "description", "repository", "homepage", "license", "brandColor"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "brandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "loginCommand", "protocolVersion"],
      "properties": {
        "command": { "const": "qodo" },
        "loginCommand": { "const": "qodo login" },
        "protocolVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "recommended", "displayName", "shortDescription", "defaultPrompt"],
        "properties": {
          "name": { "type": "string", "pattern": "^qodo-[a-z0-9-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
          "recommended": { "type": "boolean" },
          "displayName": { "type": "string", "minLength": 1 },
          "shortDescription": { "type": "string", "minLength": 1, "maxLength": 80 },
          "defaultPrompt": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
